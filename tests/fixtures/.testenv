# MinIO Manager Integration Test Configuration
# This file should be used for running integration tests with the local test environment
# Run 'make run-test-environment' to set up the test MinIO instance

# Cluster Configuration
MINIO_MANAGER_CLUSTER_NAME=test-cluster

# MinIO Connection Settings
MINIO_MANAGER_S3_ENDPOINT=localhost:9000
MINIO_MANAGER_S3_ENDPOINT_SECURE=false

# Controller User
MINIO_MANAGER_MINIO_CONTROLLER_USER=local-test-controller

# Application Settings
MINIO_MANAGER_DRY_RUN=false
MINIO_MANAGER_LOG_LEVEL=INFO
MINIO_MANAGER_AUTO_CREATE_SERVICE_ACCOUNT=true

# Secrets Backend Configuration
MINIO_MANAGER_SECRET_BACKEND_TYPE=yaml
MINIO_MANAGER_SECRET_BACKEND_PATH=tests/fixtures/testsecrets-insecure.yaml
MINIO_MANAGER_SECRET_BACKEND_S3_ACCESS_KEY=minioadmin
MINIO_MANAGER_SECRET_BACKEND_S3_SECRET_KEY=minioadmin

# Default Policies
MINIO_MANAGER_DEFAULT_BUCKET_POLICY_FILE=tests/fixtures/bucket_policies/test_default_bucket_policy.json
MINIO_MANAGER_DEFAULT_LIFECYCLE_POLICY_FILE=tests/fixtures/lifecycle_policies/default_lifecycle_30_days.json

# Bucket Configuration
MINIO_MANAGER_DEFAULT_BUCKET_VERSIONING=Suspended
MINIO_MANAGER_ALLOWED_BUCKET_PREFIXES=integration-test-,test-,demo-
