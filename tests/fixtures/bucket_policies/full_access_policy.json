{
  "Version": "2012-10-17", 
  "Statement": [
    {
      "Sid": "FullAccess",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject", 
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::integration-test-custom-bucket",
        "arn:aws:s3:::integration-test-custom-bucket/*"
      ]
    }
  ]
}
